# =========================
# TinyAgent / TinyLLM-Story
# 忽略隐私文件、密钥、虚拟环境与库缓存
# =========================

# ----- 环境变量与密钥 -----
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json

# ----- 本地数据库与用户数据 -----
*.db
*.db-journal
*.sqlite
*.sqlite3
tinyllm.db

# ----- Python 虚拟环境 / 依赖库 -----
.venv/
venv/
env/
ENV/
virtualenv/
pip-wheel-metadata/
*.egg-info/
*.egg
.Python
site-packages/

# ----- Python 字节码与缓存 -----
